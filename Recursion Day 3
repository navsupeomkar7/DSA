//Recursive Multiplication using only substraction and addition
public class Main
{
    public static long recmul(int n, int m){
        if(n==0){
            return 0;
        }
        
        long sub = recmul(n-1,m);
        
        return sub+m;
    }
	public static void main(String[] args) {
		long n  =  recmul(5 , 5);
		
		System.out.println(n);
	}
}
