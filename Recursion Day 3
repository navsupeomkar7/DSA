// Sum of natural numbers N to 1
public class Main
{
    public static long sum1ton(int n){
        if(n==0){
            return 0;
        }
        
        long sub = sum1ton(n-1);
        
        return n+sub;
    }
	public static void main(String[] args) {
		
		long n = sum1ton(5);
		
		System.out.println(n);
		
	}
}

