// Power Calculation Time Complexity O(N) 
public class Main
{
    public static long powxton(int x, int n){
        if(n==0){
            return 1;
        }
        
        long t = powxton(x,n-1);
        
        return t*x;
    }
	public static void main(String[] args) {
		long n = powxton(2,3);
		
		System.out.println(n);
	}
}
