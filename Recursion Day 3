// Optimized Power Calculation Time Complexity O(log2 n)
public class Main
{
    public static long power(int x, int n){
        if(n==0){
            return 1;
        }
        
        long sub = power(x,n/2);
        
        if(n%2==0){
            return sub*sub;
        }
        
        return sub*sub*x;
    }
	public static void main(String[] args) {
		long n = power(2,32);
		
		System.out.println(n);
	}
}
