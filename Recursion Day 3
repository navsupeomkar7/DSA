// Product of natural numbers N to 1
public class Main
{
    public static long productN(int n){
        if(n==0){
            return 1;
        }
        
        long sub = productN(n-1);
        
        return sub*n;
    }
	public static void main(String[] args) {
		long n = productN(5);
		
		System.out.println(n);
	}
}

